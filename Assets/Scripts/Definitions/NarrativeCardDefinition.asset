    narrativeBeatSprite: {fileID: 0}
    prefab: {fileID: 8031229054714573727, guid: 46144ee6793e7274fad2d555075b3d10, type: 3}
    ending: 4
  - messageContent: "\u201CI couldn\u2019t figure out why this kept happening, and
      it was making me crazy.<br><br>I had my suspicions, but I needed to be sure.
      So I ordered some equipment to\u2026 surveil the apartment.\u201D"
    wasShown: 0
    narrativePhase: 4
    narrativeOrder: 0
    cardDuration: 10
    narrativeBeatSprite: {fileID: 0}
    prefab: {fileID: 8031229054714573727, guid: 46144ee6793e7274fad2d555075b3d10, type: 3}
    ending: 1
