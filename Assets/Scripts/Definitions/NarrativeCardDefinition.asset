    ending: 4
  - messageContent: "\u201CI\u2019ve been meaning to talk to you, but I just haven\u2019t
      had the time lately. I\u2019m sure you\u2019ve noticed a few changes around
      the place.\u201D"
    wasShown: 0
    narrativePhase: 4
    narrativeOrder: 0
    cardDuration: 10
    narrativeBeatSprite: {fileID: 0}
    prefab: {fileID: 8031229054714573727, guid: 46144ee6793e7274fad2d555075b3d10, type: 3}
