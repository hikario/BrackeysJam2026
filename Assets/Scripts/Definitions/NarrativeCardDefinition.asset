    wasShown: 0
    narrativePhase: 4
    narrativeOrder: 12
    cardDuration: 10
    narrativeBeatSprite: {fileID: 0}
    prefab: {fileID: 8031229054714573727, guid: 46144ee6793e7274fad2d555075b3d10, type: 3}
    ending: 2
  - messageContent: "\u201CMorning. I've got some coffee on the pot if you'd like
      some\u201D"
    wasShown: 0
    narrativePhase: 4
    narrativeOrder: 12
    cardDuration: 10
    narrativeBeatSprite: {fileID: 0}
    prefab: {fileID: 8031229054714573727, guid: 46144ee6793e7274fad2d555075b3d10, type: 3}
    ending: 3
  - messageContent: "\u201CMorning. I've got some coffee on the pot if you'd like
      some\u201D"
    wasShown: 0
    narrativePhase: 4
    narrativeOrder: 12
    cardDuration: 10
    narrativeBeatSprite: {fileID: 0}
    prefab: {fileID: 8031229054714573727, guid: 46144ee6793e7274fad2d555075b3d10, type: 3}
    ending: 4
  - messageContent: I took a seat at the table across from my roommate. I could tell
      that things between us had grown tense, but this would likely be my only opportunity
      to lay it all out.
    wasShown: 0
    narrativePhase: 4
    narrativeOrder: 0
    cardDuration: 10
    narrativeBeatSprite: {fileID: 0}
    prefab: {fileID: 8031229054714573727, guid: 46144ee6793e7274fad2d555075b3d10, type: 3}
    ending: 1
