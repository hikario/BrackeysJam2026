  messages:
  - messageText: Hey! Just wanted to give you a heads-up, I left for work while you
      were asleep. I'll be home late, so you'll have the house to yourself as usual.
      Help yourself to some fruit. See you later. :)
    messagePhase: 0
    isPlayerMessage: 0
    isSent: 0
    isResponse: 0
    isResponseTo: 
    hasResponse: 0
    responseIs: 
  - messageText: Thanks for the heads-up, maybe you could give me a heads-up next
      time you take what isn't yours
    messagePhase: 0
    isPlayerMessage: 1
    isSent: 1
    isResponse: 0
    isResponseTo: 
    hasResponse: 1
    responseIs: Yeah, uh sure thing???
  - messageText: Yeah, uh sure thing???
    messagePhase: 1
    isPlayerMessage: 0
    isSent: 0
    isResponse: 1
    isResponseTo: Thanks for the heads-up, maybe you could give me a heads-up next
      time you take what isn't yours
    hasResponse: 0
